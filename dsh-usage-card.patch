@@ -0,0 +1,1370 @@
+/* Usage card: full card above Settings when wide, compact period pill on the
+   rail. Visual hierarchy — level 1: balance + today cost (large metrics);
+   level 2: today's tokens; level 3: badge/estimate/updated + chart legend.
+   Tokens use the sidebar's design aliases so the card follows both themes. */
+
+.card {
+  position: relative;
+  flex: 1;
+  min-width: 0;
+  padding: 10px 12px 9px;
+  margin: 4px 0 2px;
+  box-sizing: border-box;
+  border: 1px solid var(--dsw-alias-border-l2-darkmode-thin, var(--dsw-alias-border-l2));
+  border-radius: 14px;
+  /* Same surface as the composer input box. */
+  background: var(--dsw-specific-input-major);
+  box-shadow: var(--dsw-shadow-lv2);
+  color: var(--dsw-alias-label-primary);
+  font-size: 12px;
+  line-height: 16px;
+  text-align: left;
+  /* The whole card toggles expanded/collapsed on click. */
+  cursor: pointer;
+  transition: background 120ms var(--ds-ease-in-out);
+}
+
+.card:hover {
+  background: var(--dsw-alias-interactive-bg-hover, var(--dsw-specific-input-major));
+}
+
+/* ── Card actions: recharge (left) + refresh (right) ─────────────────────── */
+
+.actions {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  margin-bottom: 1px;
+}
+
+.recharge {
+  display: inline-flex;
+  align-items: center;
+  gap: 3px;
+  padding: 2px 8px;
+  border-radius: 999px;
+  border: 1px solid var(--dsw-alias-border-l2);
+  background: transparent;
+  color: var(--dsw-alias-label-secondary);
+  font-size: 10px;
+  line-height: 14px;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.recharge:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+
+.rechargePlus {
+  font-size: 11px;
+  line-height: 12px;
+  font-weight: 600;
+}
+
+.refreshBtn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 20px;
+  height: 20px;
+  padding: 0;
+  border: none;
+  border-radius: 50%;
+  background: transparent;
+  color: var(--dsw-alias-label-secondary);
+  font-size: 13px;
+  line-height: 1;
+  cursor: pointer;
+}
+
+.refreshBtn:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+/* ── 3D flip: front dashboard / back settings ───────────────────────────── */
+
+.card {
+  perspective: 1200px;
+}
+
+.cardInner {
+  display: grid;
+}
+
+.faceFront,
+.faceBack {
+  grid-area: 1 / 1;
+  /* Grid items default to min-width: auto — without this the face's content
+     (chart columns, metrics) would refuse to shrink and overflow the card to
+     the right, making it flush against the sidebar edge. */
+  min-width: 0;
+  backface-visibility: hidden;
+  transition: transform 420ms var(--ds-ease-in-out), visibility 420ms;
+}
+
+.faceFront {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+}
+
+/* The back sits in the same grid cell, so while both faces are mounted the
+   card grows to the taller one (adaptive, no scrollbar); the back unmounts
+   after the flip-out animation so the size shrinks back to the front. */
+.faceBack {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  transform: rotateY(180deg);
+  visibility: hidden;
+}
+
+.card.flipped .faceFront {
+  transform: rotateY(180deg);
+  visibility: hidden;
+}
+
+.card.flipped .faceBack {
+  transform: rotateY(0deg);
+  visibility: visible;
+}
+
+/* ── Settings button (front) ─────────────────────────────────────────────── */
+
+.actionsLeft {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+
+/* Bare settings gear: a plain glyph, no button chrome (no capsule). */
+.settingsGear {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex: none;
+  width: 22px;
+  height: 22px;
+  padding: 0;
+  border: none;
+  background: transparent;
+  color: var(--dsw-alias-label-secondary);
+  /* The ⚙ glyph renders smaller than ↻ at the same font size, so bump it to
+     match the refresh icon's visual weight. */
+  font-size: 15px;
+  line-height: 1;
+  cursor: pointer;
+}
+
+.settingsGear:hover {
+  color: var(--dsw-alias-label-primary);
+}
+
+/* ── Back face: settings panel ───────────────────────────────────────────── */
+
+.settingsHeader {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.settingsTitle {
+  font-size: 11px;
+  font-weight: 600;
+  line-height: 15px;
+  color: var(--dsw-alias-label-primary);
+}
+
+.settingsClose {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 20px;
+  height: 20px;
+  padding: 0;
+  border: none;
+  border-radius: 50%;
+  background: transparent;
+  color: var(--dsw-alias-label-secondary);
+  font-size: 11px;
+  line-height: 1;
+  cursor: pointer;
+}
+
+.settingsClose:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+
+.settingsSection {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding-top: 6px;
+  border-top: 1px solid var(--dsw-alias-border-l2);
+}
+
+.settingsLabel {
+  font-size: 10px;
+  line-height: 14px;
+  color: var(--dsw-alias-label-secondary);
+}
+
+.tokenInput {
+  width: 100%;
+  box-sizing: border-box;
+  padding: 4px 8px;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: 7px;
+  background: var(--dsw-specific-input-major);
+  color: var(--dsw-alias-label-primary);
+  font-size: 11px;
+  line-height: 16px;
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+}
+
+.tokenInput::placeholder {
+  color: var(--dsw-alias-label-tertiary, var(--dsw-alias-label-secondary));
+}
+
+.settingsBtnPrimary,
+.settingsBtn,
+.backBtn {
+  align-self: flex-start;
+  padding: 2px 10px;
+  border-radius: 999px;
+  font-size: 10px;
+  line-height: 16px;
+  cursor: pointer;
+}
+
+.settingsBtnPrimary {
+  border: 1px solid transparent;
+  background: var(--dsw-alias-button-primary-fill);
+  color: var(--dsw-alias-label-primary-foreground);
+}
+
+.settingsBtnPrimary:disabled {
+  opacity: 0.5;
+  cursor: default;
+}
+
+.settingsBtn {
+  border: 1px solid var(--dsw-alias-border-l2);
+  background: transparent;
+  color: var(--dsw-alias-label-secondary);
+}
+
+.settingsBtn:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+
+.tokenState {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  min-width: 0;
+}
+
+.tokenOk {
+  flex: none;
+  font-size: 10px;
+  line-height: 14px;
+  color: var(--dsw-alias-state-success-primary);
+  white-space: nowrap;
+}
+
+.settingsError {
+  font-size: 10px;
+  line-height: 14px;
+  color: var(--dsw-alias-interactive-bg-hover-danger, var(--dsw-alias-label-secondary));
+}
+
+.settingsNotice {
+  font-size: 10px;
+  line-height: 14px;
+  color: var(--dsw-alias-state-success-primary);
